# Leave DATABASE_URL blank to use the local SQLite database.
# For Neon, paste the PostgreSQL connection string into the backend host's
# private DATABASE_URL environment variable (not into the frontend).
DATABASE_URL=

# Generate a unique random secret for every deployed environment.
PAHUNCH_JWT_SECRET=

# Set this on the backend host to the exact deployed frontend origin.
PAHUNCH_CORS_ORIGINS=http://localhost:5173

# Optional local SQLite file override.
# PAHUNCH_DB=backend/data/pahunch.db
